{
  "name": "@web-reaper/cli",
  "version": "0.1.0",
  "description": "CLI for web-reaper testing tool",
  "type": "module",
  "bin": {
    "web-reaper": "./dist/index.js",
    "reaper": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
